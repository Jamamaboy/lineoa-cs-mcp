# The real LINE OA Manager by default. Set LINEOA_MOCK=1 to use the built-in mock instead.
LINEOA_BASE_URL=https://chat.line.biz
# LINEOA_MOCK=1
# Session file written by `npm run login` (never commit it).
LINEOA_SESSION_FILE=~/.config/lineoa-mcp/session.json
# Only these OA bot ids are reachable (comma-separated). Empty = all OAs the staff member can see.
LINEOA_BOT_ALLOWLIST=
# OA to use when a request names none (name, @id or botId). Empty = the AI asks which OA.
LINEOA_DEFAULT_OA=
# Read-only by default. Set to "true" to register send_message (allowlist, daily cap and audit log still apply).
LINEOA_ALLOW_SEND=false
