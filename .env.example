# Where the server talks to. Default is the local mock; set the real console for live use.
LINEOA_BASE_URL=http://127.0.0.1:8787
# Session file written by `npm run login` (never commit it).
LINEOA_SESSION_FILE=~/.config/lineoa-mcp/session.json
# Only these OA bot ids are reachable (comma-separated). Empty = all OAs the staff member can see.
LINEOA_BOT_ALLOWLIST=
# Sending is off unless this is "true".
LINEOA_ALLOW_SEND=false
