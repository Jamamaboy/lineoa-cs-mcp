{
  "mcpServers": {
    "lineoa-cs": {
      "command": "node",
      "args": ["--import", "tsx", "src/index.ts"],
      "env": {
        "LINEOA_ALLOW_SEND": "false"
      }
    },
    "lineoa-cs-mock": {
      "command": "node",
      "args": ["--import", "tsx", "src/index.ts"],
      "env": {
        "LINEOA_MOCK": "1",
        "LINEOA_MOCK_PORT": "0",
        "LINEOA_ALLOW_SEND": "true"
      }
    }
  }
}
