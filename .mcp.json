{
  "mcpServers": {
    "lineoa-cs": {
      "command": "npx",
      "args": ["tsx", "src/index.ts"],
      "env": {
        "LINEOA_ALLOW_SEND": "false"
      }
    },
    "lineoa-cs-mock": {
      "command": "npx",
      "args": ["tsx", "src/index.ts"],
      "env": {
        "LINEOA_MOCK": "1"
      }
    }
  }
}
