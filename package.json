{
  "name": "lineoa-cs-mcp",
  "version": "0.2.0",
  "description": "MCP server that lets an AI agent work LINE OA Manager chat (chat.line.biz) the way a CS person does",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lineoa-cs-mcp": "dist/src/index.js",
    "lineoa": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "mock": "tsx mock-server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "try": "tsx scripts/try.ts",
    "login": "tsx src/cli.ts login",
    "lineoa": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts setup",
    "smoke": "node scripts/smoke-dist.mjs",
    "features": "tsx scripts/features-page.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "~1.32.2",
    "hono": "^4.13.16",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.5",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
